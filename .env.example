# App
NODE_ENV=development
PORT=3000
DEFAULT_LANGUAGE=vi

# MySQL (chạy qua docker compose — xem docker-compose.yml)
# DB_PORT=3307 vì cổng 3306 có thể đã bị MySQL cài sẵn trên máy chiếm
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=conduit

# Redis (blacklist token lúc logout)
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=nestjs-tutorial-secret-key-that-is-at-least-32-characters-long
JWT_EXPIRES_IN="7d",